rules_version = '2';

// Reglas de la base. Sin sesión no se puede leer ni escribir nada.
//
// - Productos: los ve cualquiera que haya entrado. Solo el supervisor los carga, cambia o borra.
// - Pallets: cualquiera que haya entrado los cierra, a su nombre. Solo el supervisor los borra.
//   Un pallet cerrado no se edita.
// - Órdenes de producción (de la COOIS): las ve cualquiera que haya entrado. Solo el supervisor
//   las importa. "coois" guarda los datos de la última importación.
// - Usuarios: cada uno ve y escribe su nombre, pero no su rol. El rol se pone a mano en la
//   consola de Firebase, y la consola no pasa por estas reglas. "Supervisor" incluye a quien
//   tenga el rol "administrador".
service cloud.firestore {
  match /databases/{database}/documents {
    function conSesion() {
      return request.auth != null;
    }

    // "administrador" es lo mismo que "supervisor". El rol se escribe a mano en la consola, así
    // que no importan los espacios de más ni las mayúsculas. js/sesion.js tiene la misma lista.
    function rolDeSupervisor(rol) {
      return rol is string && rol.trim().lower() in ['supervisor', 'administrador'];
    }

    function esSupervisor() {
      return conSesion()
        && rolDeSupervisor(get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('rol', ''));
    }

    function nombreValido() {
      return request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 40;
    }

    match /productos/{id} {
      allow read: if conSesion();
      allow create, update, delete: if esSupervisor();
    }

    match /pallets/{id} {
      allow read: if conSesion();
      allow create: if conSesion() && request.resource.data.creadoPor == request.auth.uid;
      allow delete: if esSupervisor();
    }

    match /ordenes/{id} {
      allow read: if conSesion();
      allow create, update, delete: if esSupervisor();
    }

    match /coois/{id} {
      allow read: if conSesion();
      allow create, update, delete: if esSupervisor();
    }

    match /usuarios/{uid} {
      allow read: if conSesion() && request.auth.uid == uid;
      allow create: if conSesion() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nombre']) && nombreValido();
      allow update: if conSesion() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre']) && nombreValido();
    }
  }
}
